{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=hexara;Username=hexara;Password=hexara"
  },
  "Hardening": {
    "BehindReverseProxy": false,
    "MigrateOnStartup": false,
    "AuthPermitsPerWindow": 10,
    "AuthWindowMinutes": 5,
    "ApiPermitsPerMinute": 120
  },
  "Chat": {
    "Enabled": true,
    "MaxLength": 300,
    "HistorySize": 60,
    "BurstLimit": 8,
    "BurstSeconds": 10
  },
  "AutoPlay": {
    "Enabled": true,
    "AbsentGraceSeconds": 25,
    "TurnDeadlineSeconds": 180,
    "PollSeconds": 5,
    "BatchSize": 20
  },
  "Vite": {
    "UseDevServer": false,
    "DevServerUrl": "http://localhost:5173",
    "PublicBase": "/dist"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}

@{
    var culture = UiTranslator.CurrentCulture();
    var isRtl = UiTranslator.IsRtl(culture);
    var dir = isRtl ? "rtl" : "ltr";
    var otherCulture = culture == "fa" ? "en" : "fa";
    var otherCultureLabel = otherCulture == "fa" ? "فارسی" : "English";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
    var avatarColor = User.FindFirst(AppUserClaimsPrincipalFactory.AvatarColorClaimType)?.Value ?? "#4f9cf9";
}
<!DOCTYPE html>
<html lang="@culture" dir="@dir" data-culture="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    @* بدون جاوااسکریپت هم نوار مرورگر با تم سیستم جور می‌ماند. اگر کاربر تم را
       دستی خلافِ سیستمش انتخاب کند فقط رنگ همین نوار عقب می‌ماند، نه صفحه. *@
    <meta name="theme-color" content="#0f0c08" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#efe2c8" media="(prefers-color-scheme: light)" />
    <meta name="description" content="@T["app.description"]" />

    @* PWA. iOS هنوز manifest را کامل نمی‌فهمد و به متاتگ‌های خودش نیاز دارد. *@
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="@T["app.name"]" />
    <meta name="mobile-web-app-capable" content="yes" />
    @* پیش از اولین رنگ‌آمیزی اجرا می‌شود تا صفحه با تم غلط پلک نزند. تا وقتی
       کاربر انتخاب نکرده باشد data-theme گذاشته نمی‌شود و CSS خودش سراغ
       prefers-color-scheme می‌رود. *@
    <script nonce="@Context.CspNonce()">
        try {
            var hxTheme = localStorage.getItem('hx-theme');
            if (hxTheme === 'light' || hxTheme === 'dark') {
                document.documentElement.dataset.theme = hxTheme;
            }
        } catch (e) { /* حالت خصوصی مرورگر — تم سیستم می‌ماند */ }
    </script>
    <title>@(ViewData["Title"] is null ? T["app.name"] : $"{ViewData["Title"]} · {T["app.name"]}")</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    @Html.ViteEntry("src/main.ts")
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="hx-body">
    <div class="hx-aurora" aria-hidden="true">
        <span class="hx-aurora__blob hx-aurora__blob--a"></span>
        <span class="hx-aurora__blob hx-aurora__blob--b"></span>
        <span class="hx-aurora__blob hx-aurora__blob--c"></span>
    </div>

    <header class="hx-header">
        <div class="hx-container hx-header__inner">
            <a class="hx-brand" asp-controller="Home" asp-action="Index">
                <svg class="hx-brand__mark" viewBox="0 0 32 32" aria-hidden="true">
                    <defs>
                        <linearGradient id="hxBrandGrad" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#5ee7c6" />
                            <stop offset="100%" stop-color="#4f9cf9" />
                        </linearGradient>
                    </defs>
                    <path d="M16 2.4 28 9.2v13.6L16 29.6 4 22.8V9.2z" fill="none" stroke="url(#hxBrandGrad)" stroke-width="2.4" stroke-linejoin="round" />
                    <path d="M16 10 22 13.5v7L16 24l-6-3.5v-7z" fill="url(#hxBrandGrad)" opacity=".9" />
                </svg>
                <span class="hx-brand__text">@T["app.name"]</span>
            </a>

            <nav class="hx-nav" aria-label="@T["nav.home"]">
                <a asp-controller="Home" asp-action="Index">@T["nav.home"]</a>
                <a asp-controller="Lobby" asp-action="Index">@T["nav.lobby"]</a>
                <a asp-controller="Leaderboard" asp-action="Index">@T["nav.leaderboard"]</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Profile" asp-action="Index">@T["nav.profile"]</a>
                }
            </nav>

            <div class="hx-header__actions">
                @* تا وقتی مرورگر نصب را پیشنهاد نکند پنهان می‌ماند؛ pwa.ts نشانش می‌دهد.
                   با hidden شروع می‌شود تا در مرورگرهایی که اصلاً نصب ندارند دیده نشود. *@
                <button type="button"
                        class="hx-btn hx-btn--ghost hx-btn--sm"
                        data-hx-install
                        hidden
                        aria-label="@T["pwa.install"]"
                        title="@T["pwa.install"]">
                    <svg class="hx-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3v12M7 11l5 5 5-5M5 20h14" />
                    </svg>
                </button>

                @* برچسب دقیق («تم روشن» / «تم تیره») را theme.ts می‌گذارد، چون فقط
                   او می‌داند تم فعلی از سیستم آمده یا انتخاب کاربر بوده. این
                   aria-label عمومی برای حالت بی‌جاوااسکریپت است. *@
                <button type="button"
                        class="hx-btn hx-btn--ghost hx-btn--sm"
                        data-hx-theme-toggle
                        data-label-light="@T["nav.themeLight"]"
                        data-label-dark="@T["nav.themeDark"]"
                        aria-label="@T["nav.theme"]"
                        title="@T["nav.theme"]">
                    <svg class="hx-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
                        <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" />
                    </svg>
                </button>

                <form asp-controller="Language" asp-action="Set" method="post" class="hx-inline-form">
                    <input type="hidden" name="culture" value="@otherCulture" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="hx-btn hx-btn--ghost hx-btn--sm" title="@T["nav.language"]">
                        @otherCultureLabel
                    </button>
                </form>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="hx-avatar" style="--hx-avatar-color:@avatarColor" title="@displayName">
                        @(string.IsNullOrEmpty(displayName) ? "?" : displayName[..1].ToUpperInvariant())
                    </span>
                    <span class="hx-header__name">@displayName</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="hx-inline-form">
                        <button type="submit" class="hx-btn hx-btn--ghost hx-btn--sm">@T["nav.logout"]</button>
                    </form>
                }
                else
                {
                    <a class="hx-btn hx-btn--ghost hx-btn--sm" asp-controller="Account" asp-action="Login">@T["nav.login"]</a>
                    <a class="hx-btn hx-btn--primary hx-btn--sm" asp-controller="Account" asp-action="Register">@T["nav.register"]</a>
                }
            </div>
        </div>
    </header>

    <main class="hx-main">
        @RenderBody()
    </main>

    <footer class="hx-footer">
        <div class="hx-container hx-footer__inner">
            <span>@T["footer.builtWith"]</span>
            <span class="hx-footer__note">@T["footer.independent"]</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model GamePlayViewModel
@{
    ViewData["Title"] = T["game.title"];
}

@* بازی پهن‌ترین صفحه‌ی سایت است تا برد جا داشته باشد. تیتر فقط برای صفحه‌خوان
   می‌ماند: نوار وضعیتِ خودِ بازی همان را با جزئیات بیشتر می‌گوید و یک تیترِ
   درشتِ این بالا فقط ارتفاعِ برد را می‌خورد. *@
<section class="hx-container hx-wide">
    <h1 class="hx-sr-only">@T["game.title"]</h1>

    @* جزیره‌ی Vue: از اینجا به بعد وضعیت زنده از هاب می‌آید، نه از سرور رندر.
       متن زیر فقط تا وقتی دیده می‌شود که جزیره سوار شود یا جاوااسکریپت نباشد. *@
    <div id="island-game-live" data-game-id="@Model.Game.Id">
        <p class="hx-muted">@T["common.loading"]</p>
    </div>
</section>
